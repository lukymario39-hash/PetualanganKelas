<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Petualangan Kelas</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
<style>
  :root{
    --bg-deep:#0b1220;
    --bg-panel:#1a2332;
    --wood:#4a3728;
    --wood-light:#6b4f38;
    --gold:#e8b04b;
    --gold-dim:#a67c33;
    --hp:#d9534f;
    --mp:#4a90d9;
    --xp:#5cb85c;
    --purple:#7c4fb5;
    --ink:#f4e8d0;
    --ink-dim:#b8ab8f;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:#0b1220;
    font-family:'VT323', monospace;
    color:var(--ink);
    padding:0 0 64px;
  }
  .pixel{font-family:'Press Start 2P', monospace;}
  h1,h2,h3{margin:0;}
  .wrap{max-width:1180px;margin:0 auto;padding:0 16px;}

  /* HERO SCENE */
  .hero{
    position:relative;
    overflow:hidden;
    background:
      radial-gradient(circle at 50% 78%, #ffdf9a 0%, #ffb35c 8%, transparent 9%),
      linear-gradient(180deg,#1c2b52 0%,#3a3168 35%,#7a4a5e 62%,#c97a54 82%,#e8a35c 100%);
    padding:34px 16px 26px;
    border-bottom:4px solid var(--wood);
  }
  .hero::before{
    content:"";
    position:absolute;left:0;right:0;bottom:0;height:38%;
    background:
      linear-gradient(180deg, transparent 0%, #14203a 60%),
      repeating-linear-gradient(115deg,#182238 0 40px, #131c31 40px 80px);
    clip-path: polygon(0% 100%, 0% 55%, 8% 62%, 16% 40%, 24% 58%, 33% 35%, 42% 60%, 52% 30%, 61% 58%, 70% 45%, 80% 62%, 90% 48%, 100% 60%, 100% 100%);
    opacity:.95;
  }
  .hero-inner{position:relative;z-index:2;text-align:center;}
  .eyebrow{font-size:10px;letter-spacing:2px;color:#ffe6b0;text-shadow:1px 1px 0 #4a2e0c;}
  .hero h1{
    font-size:clamp(24px,4.4vw,42px);
    color:var(--gold);
    text-shadow:3px 3px 0 #3a2408, 0 0 26px rgba(232,176,75,0.4);
    margin:10px 0 10px;
  }
  .classname-row{
    display:flex;justify-content:center;align-items:center;gap:8px;
    font-size:19px;color:#fff3da;
  }
  .classname-row input{
    background:rgba(0,0,0,0.25);border:none;border-bottom:2px dashed var(--gold-dim);
    color:var(--gold);font-family:'VT323',monospace;font-size:20px;text-align:center;
    padding:3px 8px;min-width:160px;border-radius:3px 3px 0 0;
  }
  .classname-row input:focus{outline:none;border-bottom-color:var(--gold);}
  .hero-quote{
    margin:18px auto 0;max-width:520px;background:rgba(11,18,32,0.55);
    border:1px solid var(--gold-dim);border-radius:6px;padding:10px 16px;
    font-size:16px;color:#ffe9c2;
  }

  .grid{
    display:grid;
    grid-template-columns:280px 1fr 300px;
    gap:18px;
    align-items:start;
    margin-top:20px;
  }
  @media(max-width:960px){
    .grid{grid-template-columns:1fr;}
  }

  .panel{
    background:var(--bg-panel);
    border:3px solid var(--wood);
    border-radius:6px;
    box-shadow:inset 0 0 0 2px #0006, 0 4px 0 #0006;
    padding:16px;
  }
  .panel > .panel-title{
    font-size:12px;color:var(--gold);margin-bottom:14px;
    display:flex;align-items:center;gap:8px;
  }
  .panel > .panel-title::before{content:"\25c6";color:var(--gold-dim);}

  /* Guru profile */
  .guru-head{display:flex;gap:10px;align-items:center;margin-bottom:12px;}
  .guru-avatar{
    width:56px;height:56px;border-radius:6px;
    background:linear-gradient(160deg,#2c3a55,#141c2b);
    border:2px solid var(--gold-dim);
    display:flex;align-items:center;justify-content:center;font-size:26px;
    flex-shrink:0;
  }
  .guru-name{font-size:16px;color:var(--ink);}
  .guru-lv{font-size:11px;color:var(--gold);}
  .bar-row{margin:8px 0;}
  .bar-label{font-size:12px;display:flex;justify-content:space-between;color:var(--ink-dim);margin-bottom:3px;}
  .bar-track{
    height:14px;background:#000a;border:1px solid #0008;border-radius:3px;overflow:hidden;
    position:relative;
  }
  .bar-fill{height:100%;border-radius:2px;transition:width .5s ease;}
  .bar-fill.hp{background:linear-gradient(180deg,#e8746f,var(--hp));}
  .bar-fill.mp{background:linear-gradient(180deg,#6bb0ec,var(--mp));}
  .bar-fill.xp{background:linear-gradient(180deg,#82d382,var(--xp));}

  .field-label{font-size:11px;color:var(--gold-dim);margin:14px 0 6px;letter-spacing:1px;}
  input[type=text], input[type=number], input[type=url], select, textarea{
    width:100%;background:#0d1420;border:1px solid var(--wood-light);color:var(--ink);
    font-family:'VT323',monospace;font-size:16px;padding:7px 8px;border-radius:4px;
  }
  textarea{resize:vertical;min-height:44px;}
  input:focus, select:focus, textarea:focus{outline:1px solid var(--gold-dim);}
  button{
    font-family:'VT323',monospace;font-size:16px;cursor:pointer;
    background:var(--wood);color:var(--ink);border:1px solid var(--gold-dim);
    border-radius:4px;padding:8px 10px;transition:transform .1s;
  }
  button:hover{background:var(--wood-light);}
  button:active{transform:scale(.96);}
  button.primary{background:var(--gold-dim);color:#20140a;border-color:var(--gold);font-weight:bold;}
  button.primary:hover{background:var(--gold);}
  button.ghost{background:transparent;border-color:#3a4a63;font-size:14px;padding:5px 8px;}
  button:disabled{opacity:.5;cursor:not-allowed;}
  .form-stack{display:flex;flex-direction:column;gap:6px;margin-bottom:10px;}
  .form-row2{display:grid;grid-template-columns:1fr 90px;gap:8px;}

  /* World map panel */
  .map-box{
    height:120px;border-radius:5px;position:relative;overflow:hidden;
    background:linear-gradient(160deg,#1f3a2c 0%,#284a35 40%,#1c3348 100%);
    border:1px solid #2a3650;margin-bottom:10px;
  }
  .map-box .loc{
    position:absolute;font-size:9px;color:#e8e0c8;background:rgba(0,0,0,0.35);
    padding:2px 5px;border-radius:3px;
  }
  .map-star{position:absolute;color:var(--gold);font-size:12px;}

  /* Quest board */
  .quest-card{
    background:#111a2a;border:1px solid #2a3650;border-radius:5px;
    padding:10px 12px;margin-bottom:10px;position:relative;
  }
  .quest-top{display:flex;justify-content:space-between;align-items:flex-start;gap:8px;}
  .quest-title{font-size:17px;color:var(--ink);}
  .quest-type{
    font-size:10px;padding:3px 7px;border-radius:10px;white-space:nowrap;
    font-family:'Press Start 2P',monospace;
  }
  .quest-type.utama{background:#3a2c0f;color:var(--gold);}
  .quest-type.sampingan{background:#182c40;color:#6bb0ec;}
  .quest-type.harian{background:#16311a;color:#82d382;}
  .quest-xp{font-size:13px;color:var(--gold-dim);margin-top:4px;}
  .quest-meta{font-size:12px;color:var(--ink-dim);margin-top:4px;}
  .quest-meta i{font-style:normal;color:var(--purple);}
  .quest-actions{display:flex;gap:6px;margin-top:8px;align-items:center;flex-wrap:wrap;}
  .quest-actions select{flex:1;min-width:120px;}
  .empty-hint{color:var(--ink-dim);font-size:14px;text-align:center;padding:20px 0;}

  /* Party / siswa */
  .siswa-card{
    display:flex;gap:10px;align-items:center;
    background:#111a2a;border:1px solid #2a3650;border-radius:5px;
    padding:8px 10px;margin-bottom:8px;
  }
  .siswa-avatar{
    width:34px;height:34px;border-radius:50%;
    background:linear-gradient(160deg,#2c3a55,#141c2b);
    border:1px solid var(--gold-dim);
    display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;
  }
  .siswa-info{flex:1;min-width:0;}
  .siswa-name-row{display:flex;justify-content:space-between;font-size:14px;}
  .siswa-name{color:var(--ink);}
  .siswa-lv{color:var(--gold-dim);font-size:12px;}
  .siswa-bar{height:8px;background:#000a;border-radius:2px;margin-top:4px;overflow:hidden;}
  .siswa-bar-fill{height:100%;background:linear-gradient(180deg,#82d382,var(--xp));}
  .siswa-del{background:none;border:none;color:#6b4f4f;font-size:14px;padding:2px 4px;}
  .siswa-del:hover{color:var(--hp);}

  .toast{
    position:fixed;top:18px;left:50%;transform:translateX(-50%) translateY(-10px);
    background:var(--wood);border:2px solid var(--gold);color:var(--gold);
    font-family:'Press Start 2P',monospace;font-size:12px;
    padding:12px 18px;border-radius:6px;opacity:0;pointer-events:none;
    transition:opacity .25s ease, transform .25s ease;z-index:80;
    box-shadow:0 6px 0 #0008;max-width:80vw;text-align:center;
  }
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
  .toast.bad{border-color:var(--hp);color:#ffb3b0;}

  .save-hint{font-size:11px;color:var(--ink-dim);text-align:center;margin-top:18px;}

  /* Peta perjalanan */
  .self-bar{
    display:flex;align-items:center;gap:10px;flex-wrap:wrap;
    background:#111a2a;border:1px solid #2a3650;border-radius:5px;
    padding:10px 12px;margin-bottom:18px;font-size:15px;
  }
  .self-bar select{width:auto;min-width:160px;flex:0 0 auto;}
  .self-bar .self-info{color:var(--ink);flex:1;min-width:180px;}
  .self-bar .self-info b{color:var(--gold);}
  .self-bar button{font-size:13px;padding:5px 10px;}

  .region-path{
    display:flex;align-items:flex-start;gap:0;position:relative;
    overflow-x:auto;padding:10px 4px 18px;
  }
  .region-path::before{
    content:"";position:absolute;left:40px;right:40px;top:44px;height:3px;
    background:repeating-linear-gradient(90deg,var(--wood-light) 0 10px, transparent 10px 18px);
    z-index:0;
  }
  .region-node{
    flex:1;min-width:110px;display:flex;flex-direction:column;align-items:center;
    position:relative;z-index:1;cursor:pointer;padding:0 4px;
  }
  .region-icon{
    width:56px;height:56px;border-radius:50%;display:flex;align-items:center;justify-content:center;
    font-size:26px;background:#111a2a;border:3px solid #2a3650;margin-bottom:8px;
    transition:transform .15s;
  }
  .region-node:hover .region-icon{transform:scale(1.06);}
  .region-node.conquered .region-icon{border-color:var(--xp);background:#16311a;}
  .region-node.current .region-icon{border-color:var(--gold);background:#3a2c0f;box-shadow:0 0 0 4px rgba(232,176,75,0.25);}
  .region-node.locked .region-icon{filter:grayscale(1);opacity:.5;}
  .region-name{font-size:12px;text-align:center;color:var(--ink);line-height:1.3;}
  .region-node.locked .region-name{color:var(--ink-dim);}
  .region-req{font-size:10px;color:var(--gold-dim);margin-top:2px;}
  .region-badge{
    position:absolute;top:-4px;right:6px;background:var(--gold);color:#20140a;
    font-size:10px;font-weight:bold;border-radius:10px;padding:1px 6px;
  }
  .region-avatars{display:flex;justify-content:center;gap:2px;margin-top:4px;flex-wrap:wrap;max-width:80px;}
  .region-avatars span{font-size:13px;}
  .region-avatars span.me{filter:drop-shadow(0 0 3px var(--gold));}
  .region-desc{
    background:#111a2a;border:1px solid #2a3650;border-radius:5px;
    padding:12px 14px;font-size:15px;color:var(--ink-dim);line-height:1.5;margin-top:6px;
  }
  .region-desc b{color:var(--gold);}

  /* Setup overlay (belum terhubung ke Sheets) */
  .setup-card{
    max-width:560px;margin:40px auto;background:var(--bg-panel);
    border:3px solid var(--wood);border-radius:8px;padding:24px;
  }
  .setup-card h2{color:var(--gold);font-size:16px;margin-bottom:10px;}
  .setup-card p{font-size:15px;color:var(--ink-dim);line-height:1.6;}
  .hidden{display:none !important;}

  /* Modal tantangan */
  .modal-overlay{
    position:fixed;inset:0;background:rgba(5,8,16,0.75);
    display:flex;align-items:center;justify-content:center;z-index:100;padding:16px;
  }
  .modal-box{
    width:100%;max-width:420px;background:var(--bg-panel);
    border:3px solid var(--gold-dim);border-radius:8px;padding:20px;
  }
  .modal-box h3{color:var(--gold);font-size:15px;margin-bottom:10px;}
  .modal-question{
    background:#111a2a;border:1px solid #2a3650;border-radius:5px;
    padding:12px;font-size:17px;color:var(--ink);margin:12px 0;line-height:1.5;
  }
  .modal-actions{display:flex;gap:8px;margin-top:14px;justify-content:flex-end;}
  .modal-feedback{font-size:14px;margin-top:8px;min-height:18px;}
  .modal-feedback.ok{color:#82d382;}
  .modal-feedback.bad{color:#e8746f;}

  .top-actions{display:flex;justify-content:flex-end;align-items:center;gap:8px;margin:10px 16px 0;flex-wrap:wrap;}
  .top-actions button{font-size:13px;padding:5px 10px;}

  body.role-siswa .guru-only{display:none !important;}
  body.role-siswa .classname-row input{pointer-events:none;border-bottom-style:solid;}
</style>
</head>
<body>

<div id="setupOverlay" class="setup-card hidden">
  <h2 class="pixel" style="font-size:14px;">HUBUNGKAN KE GOOGLE SHEETS</h2>
  <p>Tempel URL Web App dari Google Apps Script Anda (hasil Deploy &gt; New deployment &gt; Web app) di bawah ini. Data quest, siswa, dan XP akan tersimpan di Google Sheet Anda.</p>
  <div class="form-stack" style="margin-top:14px;">
    <input type="url" id="apiUrlInput" placeholder="https://script.google.com/macros/s/xxxxx/exec" />
    <button class="primary" id="saveApiUrlBtn">Simpan &amp; Sambungkan</button>
  </div>
  <p id="setupError" style="color:#e8746f;"></p>
</div>

<div id="gameRoot" class="hidden">

  <div class="hero">
    <div class="hero-inner">
      <div class="eyebrow pixel">BELAJAR &middot; BERKARYA &middot; MENGINSPIRASI</div>
      <h1 class="pixel">PETUALANGAN KELAS</h1>
      <div class="classname-row">
        Kelas: <input type="text" id="classNameInput" placeholder="Nama kelas Anda" />
      </div>
      <div class="hero-quote">"Ilmu adalah petualangan tanpa akhir." &mdash; setiap siswa adalah pahlawan.</div>
    </div>
  </div>

  <div class="top-actions">
    <span id="roleLabel" style="font-size:13px;color:var(--ink-dim);align-self:center;">Tampilan: Siswa</span>
    <button class="ghost guru-only" id="changeApiBtn">Ganti sambungan Sheets</button>
    <button class="ghost" id="refreshBtn">Muat ulang data</button>
    <button class="ghost" id="toggleRoleBtn">Masuk sebagai Guru</button>
  </div>

  <div class="wrap">
    <div class="grid">

      <!-- GURU PROFILE -->
      <div class="panel">
        <div class="panel-title pixel">GURU</div>
        <div class="guru-head">
          <div class="guru-avatar">&#129497;</div>
          <div>
            <div class="guru-name" id="guruName">Pak/Bu Guru</div>
            <div class="guru-lv pixel" id="guruLevel">LV. 1</div>
          </div>
        </div>
        <div class="bar-row">
          <div class="bar-label"><span>SEMANGAT</span><span>100/100</span></div>
          <div class="bar-track"><div class="bar-fill hp" style="width:100%"></div></div>
        </div>
        <div class="bar-row">
          <div class="bar-label"><span>FOKUS</span><span>100/100</span></div>
          <div class="bar-track"><div class="bar-fill mp" style="width:100%"></div></div>
        </div>
        <div class="bar-row">
          <div class="bar-label"><span>EXP KELAS</span><span id="guruXpText">0 / 100</span></div>
          <div class="bar-track"><div class="bar-fill xp" id="guruXpBar" style="width:0%"></div></div>
        </div>
        <div style="font-size:12px;color:var(--ink-dim);margin-top:10px;line-height:1.5;">
          Level guru naik dari total XP seluruh siswa. Semakin banyak tantangan terjawab benar, semakin cepat naik level.
        </div>

        <div style="font-size:12px;color:var(--gold-dim);margin-top:16px;">
          &#8594; Lihat peta perjalanan lengkap di bawah papan quest.
        </div>
      </div>

      <!-- QUEST BOARD -->
      <div class="panel">
        <div class="panel-title pixel">PAPAN QUEST</div>

        <div class="form-stack guru-only">
          <input type="text" id="questTitle" placeholder="Judul quest, mis. Kalahkan Bab Pecahan" />
          <div class="form-row2">
            <select id="questType">
              <option value="utama">&#11088; Misi Utama</option>
              <option value="sampingan">&#128172; Misi Sampingan</option>
              <option value="harian">&#127807; Misi Harian</option>
            </select>
            <input type="number" id="questXp" placeholder="XP" value="20" min="1" />
          </div>
          <textarea id="questQuestion" placeholder="Pertanyaan tantangan (opsional), mis. Berapa hasil dari 3/4 + 1/4 ?"></textarea>
          <input type="text" id="questAnswer" placeholder="Jawaban benar (opsional, tidak terlihat siswa)" />
          <button class="primary" id="addQuestBtn">+ Tambah Quest</button>
        </div>

        <div id="questList" style="margin-top:14px;"></div>
      </div>

      <!-- PARTY / SISWA -->
      <div class="panel">
        <div class="panel-title pixel">PARTY (SISWA)</div>
        <div id="siswaList"></div>

        <div class="field-label pixel" style="font-size:10px;">TAMBAH SISWA</div>
        <div class="form-stack">
          <input type="text" id="siswaName" placeholder="Nama siswa" />
          <button id="addSiswaBtn">+ Tambah ke Party</button>
        </div>
      </div>

    </div>

    <!-- PETA PERJALANAN -->
    <div class="panel" style="margin-top:18px;">
      <div class="panel-title pixel">PETA PERJALANAN</div>

      <div id="selfBar" class="self-bar"></div>

      <div id="regionPath" class="region-path"></div>
      <div id="regionDesc" class="region-desc"></div>
    </div>

    <div class="save-hint">Data tersimpan langsung di Google Sheets Anda &mdash; bisa dibuka dari perangkat mana saja.</div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
var AVATARS = ['\ud83e\uddd1\u200d\ud83c\udf93','\ud83e\udddd','\ud83e\uddb8','\ud83e\uddd1\u200d\ud83d\ude80','\ud83e\uddd1\u200d\ud83d\udd2c','\ud83e\udd77','\ud83e\uddd1\u200d\ud83c\udfa8','\ud83e\uddd9\u200d\u2642\ufe0f','\ud83e\udddd\u200d\u2640\ufe0f','\ud83e\uddb9'];
var QUEST_ICON = { utama:'\u2b50', sampingan:'\ud83d\udcac', harian:'\ud83c\udf3f' };
var QUEST_LABEL = { utama:'Utama', sampingan:'Sampingan', harian:'Harian' };
var API_URL_KEY = 'petualangan-kelas-api-url';
var ROLE_KEY = 'petualangan-kelas-role';
var SELF_KEY = 'petualangan-kelas-self-id';

// Wilayah peta petualangan. Setiap kali level siswa naik melewati "minLevel"
// wilayah berikutnya, siswa dianggap "berpindah tempat" di peta.
var REGIONS = [
  { id:'desa', nama:'Desa Ilmu', ikon:'\ud83c\udfd8\ufe0f', minLevel:1,
    cerita:'Titik awal petualangan. Di sini siswa mulai mengumpulkan XP pertama mereka dari misi-misi harian.' },
  { id:'hutan', nama:'Hutan Kreativitas', ikon:'\ud83c\udf32', minLevel:3,
    cerita:'Wilayah penuh ide dan karya. Sampai di sini berarti sudah cukup rajin menyelesaikan misi sampingan.' },
  { id:'gunung', nama:'Gunung Pengetahuan', ikon:'\u26f0\ufe0f', minLevel:5,
    cerita:'Medan yang menantang. Hanya petualang dengan pemahaman kuat yang bisa mendaki sejauh ini.' },
  { id:'akademi', nama:'Akademi Inspirasi', ikon:'\ud83c\udff0', minLevel:7,
    cerita:'Tempat para pahlawan belajar berlatih. Level ini menandakan penguasaan materi yang semakin matang.' },
  { id:'pelabuhan', nama:'Pelabuhan Pengalaman', ikon:'\u26f5', minLevel:9,
    cerita:'Siap berlayar ke tantangan yang lebih besar. Pengalaman yang terkumpul sudah sangat banyak.' },
  { id:'menara', nama:'Menara Malas', ikon:'\ud83d\uddfc', minLevel:12,
    cerita:'Wilayah terakhir! Menaklukkannya berarti mengalahkan rasa malas sepenuhnya. Selamat, Pahlawan Kelas!' }
];

function regionForLevel(level){
  var current = REGIONS[0];
  for(var i=0;i<REGIONS.length;i++){
    if(level >= REGIONS[i].minLevel) current = REGIONS[i];
  }
  return current;
}

var selectedRegionId = null;

// Guru: sebelum meng-upload/membagikan file ini, tempel URL Web App Anda
// di antara tanda kutip di bawah ini. Kalau diisi, siswa yang membuka link
// TIDAK akan diminta menempel URL sendiri lagi.
var DEFAULT_API_URL = 'https://script.google.com/macros/s/AKfycbwrLXshrlC_QP2vmPtcVv1yYOZ_gTfJc8TVcFdSOHihlOFIXmTH0M_IMuief8_OH877/exec';

var API_URL = '';
var ROLE = 'siswa';
var state = { className:'', quests:[], students:[] };

function applyRole(){
  document.body.classList.toggle('role-siswa', ROLE === 'siswa');
  document.getElementById('roleLabel').textContent = 'Tampilan: ' + (ROLE === 'guru' ? 'Guru' : 'Siswa');
  document.getElementById('toggleRoleBtn').textContent = ROLE === 'guru' ? 'Keluar dari mode Guru' : 'Masuk sebagai Guru';
}

document.getElementById('toggleRoleBtn').addEventListener('click', function(){
  if(ROLE === 'siswa'){
    var pw = window.prompt('Masukkan kata sandi guru untuk mengelola quest dan siswa:');
    if(pw === null) return;
    // Ganti 'guru123' dengan kata sandi pilihan Anda sebelum membagikan link ke siswa.
    if(pw !== 'bajuri39'){ showToast('Kata sandi salah.', true); return; }
    ROLE = 'guru';
  } else {
    ROLE = 'siswa';
  }
  localStorage.setItem(ROLE_KEY, ROLE);
  applyRole();
});

/* ---------- API helpers ---------- */

function apiGet(action){
  return fetch(API_URL + '?action=' + encodeURIComponent(action))
    .then(function(res){ return res.json(); });
}

// Dikirim sebagai text/plain supaya browser tidak melakukan CORS preflight,
// yang tidak didukung langsung oleh Web App Google Apps Script.
function apiPost(action, payload){
  var body = Object.assign({ action: action }, payload || {});
  return fetch(API_URL, {
    method: 'POST',
    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
    body: JSON.stringify(body)
  }).then(function(res){ return res.json(); });
}

/* ---------- Setup / koneksi ---------- */

function initApiUrl(){
  API_URL = localStorage.getItem(API_URL_KEY) || DEFAULT_API_URL || '';
  ROLE = localStorage.getItem(ROLE_KEY) || 'siswa';
  applyRole();
  if(!API_URL){
    document.getElementById('setupOverlay').classList.remove('hidden');
    document.getElementById('gameRoot').classList.add('hidden');
  } else {
    document.getElementById('setupOverlay').classList.add('hidden');
    document.getElementById('gameRoot').classList.remove('hidden');
    loadState();
  }
}

document.getElementById('saveApiUrlBtn').addEventListener('click', function(){
  var val = document.getElementById('apiUrlInput').value.trim();
  var errEl = document.getElementById('setupError');
  errEl.textContent = '';
  if(!val || val.indexOf('https://script.google.com') !== 0){
    errEl.textContent = 'URL sepertinya belum benar. Pastikan menyalin URL Web App dari Apps Script.';
    return;
  }
  localStorage.setItem(API_URL_KEY, val);
  localStorage.setItem(ROLE_KEY, 'guru');
  initApiUrl();
});

document.getElementById('changeApiBtn').addEventListener('click', function(){
  localStorage.removeItem(API_URL_KEY);
  initApiUrl();
});

document.getElementById('refreshBtn').addEventListener('click', function(){
  loadState();
});

/* ---------- State & render ---------- */

function loadState(){
  apiGet('getState').then(function(data){
    if(data.error){ showToast('Gagal memuat: ' + data.error, true); return; }
    state = data;
    render();
  }).catch(function(){
    showToast('Tidak bisa terhubung ke Google Sheets. Cek URL Web App.', true);
  });
}

function levelFromXp(xp){ return Math.floor(xp/100)+1; }
function xpIntoLevel(xp){ return xp%100; }
function totalClassXp(){ return state.students.reduce(function(s,st){return s+st.xp;},0); }

function showToast(msg, isBad){
  var t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.toggle('bad', !!isBad);
  t.classList.add('show');
  clearTimeout(showToast._timer);
  showToast._timer = setTimeout(function(){ t.classList.remove('show'); }, 2400);
}

function render(){
  document.getElementById('classNameInput').value = state.className || '';
  document.getElementById('guruName').textContent = state.className ? ('Wali ' + state.className) : 'Pak/Bu Guru';

  var totalXp = totalClassXp();
  var lv = levelFromXp(totalXp);
  var into = xpIntoLevel(totalXp);
  document.getElementById('guruLevel').textContent = 'LV. ' + lv;
  document.getElementById('guruXpText').textContent = into + ' / 100';
  document.getElementById('guruXpBar').style.width = into + '%';

  renderQuests();
  renderSiswa();
  renderSelfBar();
  renderMap();
}

/* ---------- Siapa kamu (pilih diri sendiri) ---------- */

function getSelfId(){ return localStorage.getItem(SELF_KEY) || ''; }

function renderSelfBar(){
  var bar = document.getElementById('selfBar');
  var selfId = getSelfId();
  var self = state.students.find(function(s){ return s.id === selfId; });

  if(self){
    var region = regionForLevel(levelFromXp(self.xp));
    bar.innerHTML =
      '<div class="self-info">Kamu: <b>'+escapeHtml(self.nama)+'</b> &middot; LV.'+levelFromXp(self.xp)+
      ' &middot; sedang di <b>'+region.ikon+' '+region.nama+'</b></div>'+
      '<button class="ghost" id="gantiSelfBtn">Bukan aku, ganti</button>';
    document.getElementById('gantiSelfBtn').addEventListener('click', function(){
      localStorage.removeItem(SELF_KEY);
      render();
    });
  } else {
    var options = state.students.map(function(s){ return '<option value="'+s.id+'">'+escapeHtml(s.nama)+'</option>'; }).join('');
    bar.innerHTML =
      '<div class="self-info">Siapa kamu di party ini?</div>'+
      (state.students.length > 0
        ? '<select id="selfSelect"><option value="">Pilih namamu...</option>'+options+'</select>'+
          '<button class="primary" id="pilihSelfBtn">Ini aku!</button>'
        : '<div class="self-info" style="color:var(--ink-dim);">Belum ada siswa terdaftar. Tambahkan namamu di panel Party.</div>');
    var pilihBtn = document.getElementById('pilihSelfBtn');
    if(pilihBtn){
      pilihBtn.addEventListener('click', function(){
        var val = document.getElementById('selfSelect').value;
        if(!val){ showToast('Pilih namamu dulu!', true); return; }
        localStorage.setItem(SELF_KEY, val);
        render();
      });
    }
  }
}

/* ---------- Peta perjalanan ---------- */

function renderMap(){
  var pathEl = document.getElementById('regionPath');
  var descEl = document.getElementById('regionDesc');
  var selfId = getSelfId();

  var currentRegionIds = {};
  state.students.forEach(function(s){
    var r = regionForLevel(levelFromXp(s.xp));
    if(!currentRegionIds[r.id]) currentRegionIds[r.id] = [];
    currentRegionIds[r.id].push(s);
  });

  var selfRegion = null;
  if(selfId){
    var self = state.students.find(function(s){ return s.id === selfId; });
    if(self) selfRegion = regionForLevel(levelFromXp(self.xp));
  }

  pathEl.innerHTML = '';
  REGIONS.forEach(function(region, idx){
    var isCurrentForAnyone = !!currentRegionIds[region.id];
    var isSelfHere = selfRegion && selfRegion.id === region.id;
    var maxLevelSoFar = state.students.reduce(function(m,s){ return Math.max(m, levelFromXp(s.xp)); }, 0);
    var status = 'locked';
    if(region.minLevel <= maxLevelSoFar){
      var nextRegion = REGIONS[idx+1];
      status = (nextRegion && nextRegion.minLevel <= maxLevelSoFar) ? 'conquered' : 'current';
    }
    if(state.students.length === 0) status = idx === 0 ? 'current' : 'locked';

    var avatarsHtml = '';
    if(currentRegionIds[region.id]){
      avatarsHtml = '<div class="region-avatars">' + currentRegionIds[region.id].map(function(s){
        var isMe = s.id === selfId;
        return '<span class="'+(isMe?'me':'')+'" title="'+escapeHtml(s.nama)+'">'+(isMe?'\ud83d\udfe1':'\ud83d\udfe2')+'</span>';
      }).join('') + '</div>';
    }

    var node = document.createElement('div');
    node.className = 'region-node ' + status;
    node.setAttribute('data-region', region.id);
    node.innerHTML =
      '<div class="region-icon">'+region.ikon+(status==='conquered' ? '<span class="region-badge">&#10003;</span>' : (status==='locked' ? '<span class="region-badge" style="background:var(--ink-dim);">&#128274;</span>' : ''))+'</div>'+
      '<div class="region-name">'+region.nama+'</div>'+
      '<div class="region-req">Lv.'+region.minLevel+(status==='locked'?' (terkunci)':'')+'</div>'+
      avatarsHtml;
    node.addEventListener('click', function(){
      selectedRegionId = region.id;
      renderRegionDesc();
    });
    pathEl.appendChild(node);
  });

  if(!selectedRegionId){
    selectedRegionId = selfRegion ? selfRegion.id : REGIONS[0].id;
  }
  renderRegionDesc();
}

function renderRegionDesc(){
  var descEl = document.getElementById('regionDesc');
  var region = REGIONS.find(function(r){ return r.id === selectedRegionId; }) || REGIONS[0];
  descEl.innerHTML = '<b>'+region.ikon+' '+region.nama+'</b> (butuh Lv.'+region.minLevel+') &mdash; ' + region.cerita;
}

function renderQuests(){
  var list = document.getElementById('questList');
  list.innerHTML = '';
  if(state.quests.length === 0){
    list.innerHTML = '<div class="empty-hint">Belum ada quest. Tambahkan satu di atas.</div>';
    return;
  }
  state.quests.forEach(function(q){
    var card = document.createElement('div');
    card.className = 'quest-card';
    var studentOptions = state.students.map(function(s){ return '<option value="'+s.id+'">'+s.nama+'</option>'; }).join('');
    card.innerHTML =
      '<div class="quest-top">'+
        '<div>'+
          '<div class="quest-title">'+QUEST_ICON[q.tipe]+' '+escapeHtml(q.judul)+'</div>'+
          '<div class="quest-xp">+'+q.xp+' XP</div>'+
          (q.pertanyaan ? '<div class="quest-meta"><i>&#10022;</i> Ada tantangan pertanyaan</div>' : '')+
        '</div>'+
        '<span class="quest-type '+q.tipe+'">'+QUEST_LABEL[q.tipe]+'</span>'+
      '</div>'+
      '<div class="quest-actions">'+
        (state.students.length > 0 ?
          '<select data-quest="'+q.id+'" class="assign-select"><option value="">Siapa yang mencoba?</option>'+studentOptions+'</select>'+
          '<button class="ghost attempt-btn" data-quest="'+q.id+'">&#9876; Coba Quest</button>'
          : '<span style="font-size:12px;color:var(--ink-dim);">Tambahkan siswa dulu untuk mencoba quest ini</span>')+
        '<button class="ghost del-quest-btn guru-only" data-quest="'+q.id+'">Hapus</button>'+
      '</div>';
    list.appendChild(card);
  });

  list.querySelectorAll('.attempt-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      var qid = btn.getAttribute('data-quest');
      var select = list.querySelector('.assign-select[data-quest="'+qid+'"]');
      var sid = select ? select.value : '';
      if(!sid){ showToast('Pilih siswa dulu!', true); return; }
      openChallengeModal(qid, sid);
    });
  });
  list.querySelectorAll('.del-quest-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      var qid = btn.getAttribute('data-quest');
      apiPost('deleteQuest', { id: qid }).then(function(data){
        if(data.error){ showToast(data.error, true); return; }
        state = data; render();
      });
    });
  });
}

function renderSiswa(){
  var list = document.getElementById('siswaList');
  list.innerHTML = '';
  if(state.students.length === 0){
    list.innerHTML = '<div class="empty-hint">Party masih kosong. Tambahkan siswa di bawah.</div>';
    return;
  }
  state.students.forEach(function(s,i){
    var lv = levelFromXp(s.xp);
    var into = xpIntoLevel(s.xp);
    var card = document.createElement('div');
    card.className = 'siswa-card';
    card.innerHTML =
      '<div class="siswa-avatar">'+AVATARS[i % AVATARS.length]+'</div>'+
      '<div class="siswa-info">'+
        '<div class="siswa-name-row"><span class="siswa-name">'+escapeHtml(s.nama)+'</span><span class="siswa-lv">LV.'+lv+'</span></div>'+
        '<div class="siswa-bar"><div class="siswa-bar-fill" style="width:'+into+'%"></div></div>'+
      '</div>'+
      '<button class="siswa-del guru-only" data-id="'+s.id+'" title="Hapus siswa">\u2715</button>';
    list.appendChild(card);
  });
  list.querySelectorAll('.siswa-del').forEach(function(btn){
    btn.addEventListener('click', function(){
      var id = btn.getAttribute('data-id');
      apiPost('deleteStudent', { id: id }).then(function(data){
        if(data.error){ showToast(data.error, true); return; }
        state = data; render();
      });
    });
  });
}

function escapeHtml(str){
  var d = document.createElement('div');
  d.textContent = str || '';
  return d.innerHTML;
}

/* ---------- Modal tantangan ---------- */

function openChallengeModal(questId, studentId){
  var quest = state.quests.find(function(q){ return q.id === questId; });
  var student = state.students.find(function(s){ return s.id === studentId; });
  if(!quest || !student) return;

  var overlay = document.createElement('div');
  overlay.className = 'modal-overlay';
  overlay.innerHTML =
    '<div class="modal-box">'+
      '<h3 class="pixel">'+QUEST_ICON[quest.tipe]+' '+escapeHtml(quest.judul)+'</h3>'+
      '<div style="font-size:14px;color:var(--ink-dim);">'+escapeHtml(student.nama)+' &middot; hadiah +'+quest.xp+' XP</div>'+
      (quest.pertanyaan
        ? '<div class="modal-question">'+escapeHtml(quest.pertanyaan)+'</div>'+
          '<input type="text" id="modalAnswerInput" placeholder="Ketik jawaban di sini" />'
        : '<div class="modal-question">Quest ini tidak punya tantangan pertanyaan. Selesaikan langsung?</div>')+
      '<div class="modal-feedback" id="modalFeedback"></div>'+
      '<div class="modal-actions">'+
        '<button class="ghost" id="modalCancelBtn">Batal</button>'+
        '<button class="primary" id="modalSubmitBtn">'+(quest.pertanyaan ? 'Jawab' : 'Selesaikan')+'</button>'+
      '</div>'+
    '</div>';
  document.body.appendChild(overlay);

  var input = document.getElementById('modalAnswerInput');
  if(input) input.focus();

  document.getElementById('modalCancelBtn').addEventListener('click', function(){
    overlay.remove();
  });

  document.getElementById('modalSubmitBtn').addEventListener('click', function(){
    submitChallenge();
  });
  if(input){
    input.addEventListener('keydown', function(e){
      if(e.key === 'Enter') submitChallenge();
    });
  }

  function submitChallenge(){
    var jawaban = input ? input.value : '';
    var submitBtn = document.getElementById('modalSubmitBtn');
    submitBtn.disabled = true;
    apiPost('submitAnswer', { questId: questId, studentId: studentId, jawaban: jawaban })
      .then(function(res){
        submitBtn.disabled = false;
        if(res.error){ showToast(res.error, true); return; }
        var feedback = document.getElementById('modalFeedback');
        if(res.benar){
          feedback.textContent = 'Benar! +' + res.xpDiperoleh + ' XP untuk ' + student.nama + '.';
          feedback.className = 'modal-feedback ok';
          state = res.state;
          render();
          setTimeout(function(){ overlay.remove(); }, 900);
        } else {
          feedback.textContent = 'Belum tepat, coba lagi.';
          feedback.className = 'modal-feedback bad';
          if(input){ input.value=''; input.focus(); }
        }
      })
      .catch(function(){
        submitBtn.disabled = false;
        showToast('Gagal mengirim jawaban. Cek koneksi.', true);
      });
  }
}

/* ---------- Form: kelas, quest, siswa ---------- */

var classNameTimer = null;
document.getElementById('classNameInput').addEventListener('input', function(e){
  var val = e.target.value;
  document.getElementById('guruName').textContent = val ? ('Wali ' + val) : 'Pak/Bu Guru';
  clearTimeout(classNameTimer);
  classNameTimer = setTimeout(function(){
    apiPost('setClassName', { nama: val });
  }, 500);
});

document.getElementById('addQuestBtn').addEventListener('click', function(){
  var titleEl = document.getElementById('questTitle');
  var typeEl = document.getElementById('questType');
  var xpEl = document.getElementById('questXp');
  var qEl = document.getElementById('questQuestion');
  var aEl = document.getElementById('questAnswer');

  var judul = titleEl.value.trim();
  if(!judul){ showToast('Isi judul quest dulu!', true); return; }
  var xp = parseInt(xpEl.value, 10) || 10;

  apiPost('addQuest', {
    judul: judul,
    tipe: typeEl.value,
    xp: xp,
    pertanyaan: qEl.value.trim(),
    jawaban: aEl.value.trim()
  }).then(function(data){
    if(data.error){ showToast(data.error, true); return; }
    titleEl.value = ''; qEl.value = ''; aEl.value = '';
    state = data; render();
  });
});

document.getElementById('addSiswaBtn').addEventListener('click', function(){
  var nameEl = document.getElementById('siswaName');
  var nama = nameEl.value.trim();
  if(!nama){ showToast('Isi nama siswa dulu!', true); return; }
  apiPost('addStudent', { nama: nama }).then(function(data){
    if(data.error){ showToast(data.error, true); return; }
    nameEl.value = '';
    state = data; render();
  });
});

initApiUrl();
</script>
